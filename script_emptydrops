# emptydrops filtering --------------------------------------------------------------

set.seed(100)
filtered_counts <- list()

for (run in runs) {
  cat("\n========================================\n")
  cat("Processing:", run, "\n")
  cat("========================================\n")
  
# temporary Seurat object 
  seurat_tmp <- CreateSeuratObject(
    counts= counts[[run]],
    project = run,
    min.cells = 0,
    min.features = 0
  )

# brief feedback
  cat("Total droplets:", ncol(seurat_tmp), "\n")
  cat("Total genes:", nrow(seurat_tmp), "\n")
  
  sparsity <- 1 - (sum(LayerData(seurat_tmp, layer = "counts") > 0) /
                     (nrow(seurat_tmp) * ncol(seurat_tmp)))
  cat("Matrix sparsity:", round(sparsity * 100, 1), "%\n")
  
umi_counts <- colSums(LayerData(seurat_tmp, layer = "counts"))
  cat("Median UMI per droplet:", median(umi_counts), "\n")
  cat("Droplets with >500 UMI:", sum(umi_counts > 500),
      "(likely cells, will be validated by EmptyDrops)\n")



sce <- as.SingleCellExperiment(seurat_tmp)
  
  empty_results <- emptyDrops(
    m = counts(sce),
    lower = 100,
    niters = 10000,
    test.ambient = TRUE
  )
  
is_cell <- empty_results$FDR < 0.01
is_cell[is.na(is_cell)] <- FALSE
validated_barcodes <- colnames(sce)[is_cell]
  
cat("Droplets tested:", ncol(sce), "\n")
cat("Cells called:", sum(is_cell),
      "(", round(sum(is_cell) / ncol(sce) * 100, 1), "%)\n")
cat("Empty droplets removed:", sum(!is_cell),
      "(", round(sum(!is_cell) / ncol(sce) * 100, 1), "%)\n")
  
# plot 
  empty_df <- data.frame(
    total_umi = colSums(counts(sce)),
    is_cell   = is_cell
  )
  
  p1 <- ggplot(empty_df, aes(x = log10(total_umi + 1), fill = is_cell)) +
    geom_histogram(bins = 50, alpha = 0.7, position = "identity") +
    scale_fill_manual(
      values = c("TRUE" = "#2E86AB", "FALSE" = "#A23B72"),
      labels = c("Cell", "Empty Droplet"),
      name   = "Classification"
    ) +
    labs(
      title    = paste("EmptyDrops:", run),
      subtitle = paste(sum(is_cell), "cells called from", ncol(sce), "droplets"),
      x = "log10(UMI + 1)", y = "Number of Droplets"
    ) +
    theme_classic() +
    theme(plot.title = element_text(face = "bold", size = 14))
  
  ggsave(
    file.path(output_dir, paste0("01_empty_droplets_", run, ".png")),
    p1, width = 10, height = 6, dpi = 300
  )
  


filtered_counts[[run]] <- counts[[run]][, is_cell]
cat("After EmptyDrops:", ncol(filtered_counts[[run]]), "cells retained\n")
  
rm(seurat_tmp, sce, empty_results, empty_df, p1, umi_counts, is_cell)
gc()
}

